# ---------------------------------------------------------------------------
# V12 Apex Atlas — environment template. Copy to .env and fill in.
# Never commit a real .env. Never paste a real secret into this file.
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. At least 32 random characters; the server refuses to
# start in production without it. Generate one with:
#   openssl rand -hex 32
# In development an ephemeral secret is generated per process, so sessions
# reset whenever you restart.
JWT_SECRET=

# Optional. Without it, every model-backed feature degrades to a clearly
# labelled local fallback. Routing, the Hermes engine, the vault and telemetry
# are deterministic and work with no key at all.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Optional. Defaults to 3000.
PORT=

# Optional. Postgres connection string. When unset the app uses SQLite at
# $DATA_DIR/apex-atlas.db — zero configuration, durable, fine for one node.
# Set this to scale out; the schema is created automatically on first boot.
DATABASE_URL=

# Optional. Force TLS for Postgres. Also inferred from sslmode=require in the URL.
PGSSL=

# Optional. Where the SQLite database is written. Defaults to ./data
DATA_DIR=

# Optional. Override the SQLite file path directly.
SQLITE_PATH=

# Optional, tests only. When set, the store conformance suite runs against
# Postgres in addition to SQLite. Use a throwaway database — the suite wipes it.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Asset marketplace
# ---------------------------------------------------------------------------

# The internal marketplace models bids for the media blocks your production
# nodes hold. There is no external exchange adapter and none is planned — see
# the scope note at the top of server/assets/index.ts.
#
# "realistic" (default) injects partial fills, rejections and dropped
# connections so the recovery paths stay exercised; "calm" fills cleanly and is
# what you want for a demo.
MARKET_BEHAVIOUR=

# Optional. Seeds two demo accounts at first boot. Leave unset in production —
# seeded credentials in a live deployment are how demo logins become breaches.
ENABLE_DEMO_USERS=
DEMO_PASSWORD=
