{
  "name": "v12-apex-atlas",
  "private": true,
  "version": "12.5.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run build:sandbox",
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:sandbox && npm run build:server",
    "build:client": "vite build",
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:pg": "tsx --test tests/store.test.ts",
    "verify:tenancy": "tsx scripts/verify-tenancy.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.8",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "js-yaml": "^5.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7.1.9",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.2"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "nanoid": "^3.3.18",
    "proxy-addr": "^2.0.8"
  }
}
